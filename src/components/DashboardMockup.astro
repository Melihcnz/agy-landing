---
/**
 * Gerçek web uygulaması üst şeridine sahip 3 sekmeli AgyProp panel önizlemesi.
 * Sekme geçişi harici /_astro/*.js ile çalışır (sıfır inline script).
 */
---

<div class="mx-auto w-full max-w-xl lg:max-w-none" aria-label="AgyProp yönetim paneli önizlemesi">
  <div class="specular-top overflow-hidden rounded-xl border border-white/[0.10] bg-[#111315] shadow-2xl shadow-black/60">
    <!-- Uygulama Üst Şeridi -->
    <div class="flex items-center justify-between gap-4 border-b border-white/[0.08] bg-[#14171a] px-5 py-3.5">
      <div class="flex items-baseline gap-2.5 min-w-0">
        <span class="text-sm font-semibold text-white truncate">Çamlık Konutları</span>
        <span class="mono-num text-xs text-zinc-500 shrink-0">48 daire</span>
      </div>
      <span class="mono-num text-xs text-zinc-500 shrink-0">Kasım 2026</span>
    </div>

    <!-- 3 Sekmeli Gezinme Çubuğu -->
    <div
      class="flex items-center gap-1 border-b border-white/[0.08] bg-[#111315] px-4 overflow-x-auto"
      role="tablist"
      aria-label="Panel görünüm sekmeleri"
    >
      <button
        type="button"
        role="tab"
        id="mockup-tab-fifo"
        data-mockup-tab="fifo"
        aria-selected="true"
        aria-controls="mockup-panel-fifo"
        class="shrink-0 border-b-2 border-emerald-500 px-3 py-2.5 text-xs font-semibold text-white transition-colors cursor-pointer"
      >
        Tahsilat &amp; FIFO
      </button>
      <button
        type="button"
        role="tab"
        id="mockup-tab-receipt"
        data-mockup-tab="receipt"
        aria-selected="false"
        aria-controls="mockup-panel-receipt"
        class="shrink-0 border-b-2 border-transparent px-3 py-2.5 text-xs font-medium text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer"
      >
        A5 PDF Makbuz
      </button>
      <button
        type="button"
        role="tab"
        id="mockup-tab-kvkk"
        data-mockup-tab="kvkk"
        aria-selected="false"
        aria-controls="mockup-panel-kvkk"
        class="shrink-0 border-b-2 border-transparent px-3 py-2.5 text-xs font-medium text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer"
      >
        KVKK Pano İcmali
      </button>
    </div>

    <!-- SEKME 1: Tahsilat & FIFO -->
    <div
      id="mockup-panel-fifo"
      role="tabpanel"
      aria-labelledby="mockup-tab-fifo"
      data-mockup-panel="fifo"
      class="mockup-panel-enter p-5 space-y-5"
    >
      <!-- Özet Göstergeler -->
      <div class="grid grid-cols-3 gap-3">
        <div class="rounded-lg border border-white/[0.07] bg-[#15171a] p-3.5">
          <p class="text-[11px] text-zinc-400">Tahsilat</p>
          <p class="mt-1.5 text-base sm:text-lg font-bold tracking-tight text-white mono-num">
            ₺142.800
          </p>
          <div class="mt-2.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]">
            <div class="h-full w-[94%] rounded-full bg-emerald-500"></div>
          </div>
          <p class="mt-1.5 text-[11px] text-zinc-400 mono-num">%94,2</p>
        </div>

        <div class="rounded-lg border border-white/[0.07] bg-[#15171a] p-3.5">
          <p class="text-[11px] text-zinc-400">Açık Bakiye</p>
          <p class="mt-1.5 text-base sm:text-lg font-bold tracking-tight text-white mono-num">
            ₺8.800
          </p>
          <p class="mt-3 text-[11px] text-zinc-500">
            <span class="mono-num text-zinc-300">4</span> daire
          </p>
        </div>

        <div class="rounded-lg border border-white/[0.07] bg-[#15171a] p-3.5">
          <p class="text-[11px] text-zinc-400">Dekont</p>
          <p class="mt-1.5 text-base sm:text-lg font-bold tracking-tight text-white mono-num">
            3
          </p>
          <p class="mt-3 text-[11px] text-zinc-500">İncelemede</p>
        </div>
      </div>

      <!-- Son Tahsilatlar -->
      <div class="rounded-lg border border-white/[0.07] bg-[#0d0f11] overflow-hidden">
        <div class="border-b border-white/[0.07] px-4 py-2.5 flex items-center justify-between text-[11px] font-medium text-zinc-400">
          <span>Son Tahsilatlar</span>
          <span>Tutar</span>
        </div>

        <div class="divide-y divide-white/[0.06] text-xs">
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="mono-num text-[11px] font-medium text-zinc-400">D-12</span>
                <span class="font-medium text-zinc-100 truncate">A*** Y*****</span>
              </div>
              <p class="mt-0.5 text-[11px] text-zinc-500">FIFO · Ekim ve Kasım borcu kapandı</p>
            </div>
            <span class="font-semibold text-white mono-num shrink-0">₺3.150</span>
          </div>

          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="mono-num text-[11px] font-medium text-zinc-400">D-07</span>
                <span class="font-medium text-zinc-100 truncate">M*** K***</span>
              </div>
              <p class="mt-0.5 text-[11px] text-zinc-500">Dekont onaylandı · Makbuz gönderildi</p>
            </div>
            <span class="font-semibold text-white mono-num shrink-0">₺1.575</span>
          </div>

          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="mono-num text-[11px] font-medium text-zinc-400">D-24</span>
                <span class="font-medium text-zinc-100 truncate">S*** D****</span>
              </div>
              <p class="mt-0.5 text-[11px] text-zinc-500">Kasım 2026 aidatı · Havale/EFT</p>
            </div>
            <span class="font-semibold text-white mono-num shrink-0">₺1.575</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SEKME 2: A5 PDF Makbuz -->
    <div
      id="mockup-panel-receipt"
      role="tabpanel"
      aria-labelledby="mockup-tab-receipt"
      data-mockup-panel="receipt"
      hidden
      class="mockup-panel-enter p-5"
    >
      <div class="rounded-lg border border-white/[0.08] bg-[#0d0f11] p-5 space-y-5">
        <div class="flex items-start justify-between gap-3 border-b border-white/[0.08] pb-4">
          <div>
            <p class="text-[11px] font-medium uppercase tracking-wider text-zinc-500">
              A5 Tahsilat Makbuzu
            </p>
            <h3 class="mt-1 text-sm font-semibold text-white">Çamlık Konutları Yönetimi</h3>
            <p class="mt-0.5 text-xs text-zinc-400">
              <span class="mono-num text-zinc-300">D-12</span> · Ahmet Yılmaz
            </p>
          </div>
          <div class="text-right mono-num text-xs">
            <p class="font-medium text-zinc-200">MKB-2026-0418</p>
            <p class="mt-1 text-[11px] text-zinc-500">23.11.2026</p>
          </div>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between text-[11px] text-zinc-500 pb-1">
            <span>Mahsup Edilen Dönem</span>
            <span>Tutar</span>
          </div>
          <div class="flex items-center justify-between rounded-md bg-[#15171a] px-3.5 py-2.5">
            <span class="text-zinc-200">Ekim 2026 Aidatı</span>
            <span class="mono-num font-medium text-white">₺1.575,00</span>
          </div>
          <div class="flex items-center justify-between rounded-md bg-[#15171a] px-3.5 py-2.5">
            <span class="text-zinc-200">Kasım 2026 Aidatı</span>
            <span class="mono-num font-medium text-white">₺1.575,00</span>
          </div>
        </div>

        <div class="flex items-end justify-between border-t border-white/[0.08] pt-4">
          <div class="text-xs space-y-0.5">
            <p class="text-zinc-500">Havale / EFT</p>
            <p class="text-zinc-400">
              Kalan bakiye: <span class="mono-num text-zinc-200">₺0,00</span>
            </p>
          </div>
          <div class="text-right">
            <p class="text-[11px] text-zinc-500">Toplam Tahsilat</p>
            <p class="mono-num text-lg font-bold text-white">₺3.150,00</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SEKME 3: KVKK Pano İcmali -->
    <div
      id="mockup-panel-kvkk"
      role="tabpanel"
      aria-labelledby="mockup-tab-kvkk"
      data-mockup-panel="kvkk"
      hidden
      class="mockup-panel-enter p-5"
    >
      <div class="rounded-lg border border-white/[0.08] bg-[#0d0f11] overflow-hidden">
        <div class="flex items-center justify-between gap-2 border-b border-white/[0.08] px-4 py-3">
          <p class="text-xs font-semibold text-white">Kasım 2026 Bina Pano İcmali</p>
          <span class="text-[11px] text-zinc-500">Ad-soyad maskeli</span>
        </div>

        <div class="divide-y divide-white/[0.06] text-xs">
          <div class="grid grid-cols-12 items-center px-4 py-2 text-[11px] text-zinc-500">
            <span class="col-span-2">Daire</span>
            <span class="col-span-5">Sakin</span>
            <span class="col-span-2 text-right">Bakiye</span>
            <span class="col-span-3 text-right">Durum</span>
          </div>

          <div class="grid grid-cols-12 items-center px-4 py-2.5">
            <span class="col-span-2 mono-num text-zinc-400">D-01</span>
            <span class="col-span-5 text-zinc-200">H*** Ö****</span>
            <span class="col-span-2 text-right mono-num text-zinc-400">₺0</span>
            <span class="col-span-3 text-right inline-flex items-center justify-end gap-1 text-zinc-300">
              <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
              <span>Ödendi</span>
            </span>
          </div>

          <div class="grid grid-cols-12 items-center px-4 py-2.5">
            <span class="col-span-2 mono-num text-zinc-400">D-02</span>
            <span class="col-span-5 text-zinc-200">K*** A*****</span>
            <span class="col-span-2 text-right mono-num text-zinc-100">₺1.575</span>
            <span class="col-span-3 text-right text-zinc-400">1 Dönem</span>
          </div>

          <div class="grid grid-cols-12 items-center px-4 py-2.5">
            <span class="col-span-2 mono-num text-zinc-400">D-03</span>
            <span class="col-span-5 text-zinc-200">E*** Ç****</span>
            <span class="col-span-2 text-right mono-num text-zinc-400">₺0</span>
            <span class="col-span-3 text-right inline-flex items-center justify-end gap-1 text-zinc-300">
              <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
              <span>Ödendi</span>
            </span>
          </div>

          <div class="grid grid-cols-12 items-center px-4 py-2.5">
            <span class="col-span-2 mono-num text-zinc-400">D-12</span>
            <span class="col-span-5 text-zinc-200">A*** Y*****</span>
            <span class="col-span-2 text-right mono-num text-zinc-400">₺0</span>
            <span class="col-span-3 text-right inline-flex items-center justify-end gap-1 text-zinc-300">
              <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
              <span>Ödendi</span>
            </span>
          </div>

          <div class="grid grid-cols-12 items-center px-4 py-2.5">
            <span class="col-span-2 mono-num text-zinc-400">D-19</span>
            <span class="col-span-5 text-zinc-200">M*** T****</span>
            <span class="col-span-2 text-right mono-num text-zinc-100">₺3.150</span>
            <span class="col-span-3 text-right text-zinc-400">2 Dönem</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
