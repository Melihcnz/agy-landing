---
import { SITE } from '../config/site';
import DashboardMockup from './DashboardMockup.astro';
---

<section class="bg-subtle-top">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-20 sm:pt-24 sm:pb-28 lg:pt-28 lg:pb-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center">
      <!-- Sol: Başlık, Açıklama & CTA -->
      <div class="lg:col-span-6 text-left">
        <h1 class="text-4xl sm:text-5xl lg:text-[3.35rem] font-extrabold tracking-[-0.035em] leading-[1.08] text-white">
          Apartman ve site yönetimini tek panelde sadeleştirin.
        </h1>

        <p class="mt-6 text-base sm:text-lg text-zinc-400 leading-relaxed max-w-xl">
          Aidat tahakkuku, otomatik FIFO borç mahsubu, A5 PDF tahsilat makbuzu ve KVKK uyumlu pano icmali tek sistemde. Excel tablolarını ve dağınık dekont takibini bırakın.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href={SITE.registerUrl}
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500 px-5 py-3 text-sm font-semibold text-[#05110a] hover:bg-emerald-400 transition-colors"
          >
            <span>14 Gün Ücretsiz Dene</span>
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <a
            href="#fiyatlandirma"
            class="inline-flex items-center justify-center rounded-lg border border-white/[0.12] bg-[#111315] px-5 py-3 text-sm font-medium text-zinc-200 hover:border-white/[0.22] hover:text-white transition-colors"
          >
            Paketleri İncele
          </a>
        </div>

        <p class="mt-4 text-xs text-zinc-500">
          14 gün ücretsiz deneme · Kredi kartı gerekmez · İstediğiniz zaman iptal
        </p>
      </div>

      <!-- Sağ: 3 Sekmeli Panel Önizlemesi -->
      <div class="lg:col-span-6">
        <DashboardMockup />
      </div>
    </div>
  </div>
</section>
