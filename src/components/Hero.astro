---
import { SITE } from '../config/site';
import DashboardMockup from './DashboardMockup.astro';
---

<section class="relative overflow-hidden bg-hero-glow">
  <div class="pointer-events-none absolute inset-0 bg-arch-grid" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14 pb-16 sm:pt-20 sm:pb-24 lg:pt-24 lg:pb-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <!-- Sol: Değer Önerisi & CTA -->
      <div class="lg:col-span-6 text-left">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-emerald-300">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span>Kredi kartı gerekmez · 14 gün ücretsiz</span>
        </div>

        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-[3.35rem] font-extrabold tracking-tight text-white leading-[1.1]">
          Apartman ve site yönetimini
          <span class="text-emerald-400"> tek panelde</span> sadeleştirin.
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-300 leading-relaxed max-w-xl">
          Excel tabloları ve manuel makbuz karmaşasını geride bırakın. Otomatik FIFO aidat mahsubu, tek tıkla A5 PDF makbuz, KVKK maskeli pano icmali ve sakin dekont takibi ile tüm apartmanlarınızı şeffaf biçimde yönetin.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href={SITE.registerUrl}
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-6 py-3.5 text-sm sm:text-base font-semibold text-[#04110b] shadow-xl shadow-emerald-500/20 hover:bg-emerald-400 transition-colors"
          >
            <span>14 Gün Ücretsiz Dene</span>
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <a
            href="#fiyatlandirma"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-500/25 bg-[#0b1410] px-6 py-3.5 text-sm sm:text-base font-medium text-slate-100 hover:border-emerald-400/50 hover:bg-[#0f1c16] transition-colors"
          >
            Paketleri İncele
          </a>
        </div>

        <ul class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2.5 text-xs sm:text-sm text-slate-400">
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
            <span>Kurulum gerektirmez</span>
          </li>
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
            <span>KVKK uyumlu çıktı</span>
          </li>
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
            <span>İstediğiniz zaman iptal</span>
          </li>
        </ul>
      </div>

      <!-- Sağ: AgyProp Panel Önizleme Maketi -->
      <div class="lg:col-span-6">
        <DashboardMockup />
      </div>
    </div>
  </div>
</section>
