---
const faqs = [
  {
    question: '14 günlük ücretsiz deneme için kredi kartı gerekli mi?',
    answer:
      'Hayır. E-posta adresinizle hesabınızı açıp kredi kartı bilgisi girmeden 14 gün boyunca tüm özellikleri kendi binalarınızla test edebilirsiniz. Deneme sonunda devam etmek isterseniz dilediğiniz paketi seçebilirsiniz.',
  },
  {
    question: 'Otomatik FIFO mahsup nasıl çalışır?',
    answer:
      'Bir daireden toplu veya kısmi ödeme geldiğinde AgyProp tutarı en eski açık aidat döneminden başlayarak sırayla borçlara dağıtır. Hangi dönemin kapandığı ve kalan bakiye otomatik hesaplanarak denetim kaydına işlenir.',
  },
  {
    question: 'KVKK maskeli pano icmali ne işe yarar?',
    answer:
      'Apartman girişindeki duyuru panosuna borç-alacak listesi asarken sakinlerin açık ad-soyad bilgilerini paylaşmak KVKK açısından risk oluşturur. AgyProp tek tıkla "A*** Y*****" biçiminde maskelenmiş, yazıcıya hazır pano icmali üretir.',
  },
  {
    question: 'Belgelerimiz ve makbuzlarımız nerede saklanıyor?',
    answer:
      'Yüklediğiniz fatura, karar defteri, sözleşme ve sakin dekontları şifreli bağlantı üzerinden Cloudflare R2 nesne depolama arşivinde saklanır. İstediğiniz zaman tarihe veya binaya göre arayıp indirebilirsiniz.',
  },
  {
    question: 'Birden fazla apartman veya siteyi tek hesaptan yönetebilir miyim?',
    answer:
      'Evet. Standart, Profesyonel ve Kurumsal paketler çoklu bina yönetimi için tasarlanmıştır. Her binanın kasası, aidat planı, sakin listesi ve belgeleri birbirinden tamamen izole tutulur.',
  },
  {
    question: 'Paketimi sonradan yükseltebilir veya aboneliğimi iptal edebilir miyim?',
    answer:
      'Evet. Yeni bina eklediğinizde üst pakete geçiş yapabilirsiniz. Aylık aboneliklerde taahhüt yoktur; dilediğiniz zaman aboneliğinizi iptal edebilir, ödenmiş dönem sonuna kadar paneli kullanmaya devam edebilirsiniz.',
  },
] as const;
---

<section id="sss" class="border-y border-white/[0.08] bg-[#0c0d0f] scroll-mt-20">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-24 sm:py-28">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-zinc-500">
        Sıkça Sorulan Sorular
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white">
        Merak edilenler.
      </h2>
    </div>

    <div class="mt-12 divide-y divide-white/[0.08] border-y border-white/[0.08]">
      {
        faqs.map((faq, idx) => (
          <details class="group py-5" open={idx === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-left text-sm sm:text-base font-medium text-zinc-100 hover:text-white select-none transition-colors">
              <span>{faq.question}</span>
              <span class="flex h-6 w-6 shrink-0 items-center justify-center text-zinc-500 transition-transform duration-200 group-open:rotate-180 group-open:text-zinc-300">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
            </summary>
            <div class="pt-3 pr-8 text-sm leading-relaxed text-zinc-400">
              {faq.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
