---
import { SITE } from '../config/site';
---

<header class="sticky top-0 z-50 border-b border-emerald-500/12 bg-[#07100c]/85 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 sm:h-[70px] items-center justify-between gap-4">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-emerald-500/30 bg-[#0b1410] shadow-sm shadow-emerald-950/60 group-hover:border-emerald-400/60 transition-colors">
          <svg class="h-5 w-5" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M16 48V24.5L32 15L48 24.5V48" stroke="#10b981" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M12 48H52" stroke="#34d399" stroke-width="3.5" stroke-linecap="round" />
            <rect x="25" y="26" width="5" height="5" rx="1" fill="#34d399" />
            <rect x="34" y="26" width="5" height="5" rx="1" fill="#34d399" />
            <rect x="25" y="34" width="5" height="5" rx="1" fill="#10b981" />
            <rect x="34" y="34" width="5" height="5" rx="1" fill="#10b981" />
          </svg>
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-display text-lg font-bold tracking-tight text-white">
            {SITE.brandName}
          </span>
          <span class="text-[10px] font-medium tracking-wide text-emerald-400/80 uppercase">
            Apartman &amp; Site
          </span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Ana menü" class="hidden md:flex items-center gap-7">
        {
          SITE.navigation.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-slate-300 hover:text-emerald-300 transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={SITE.loginUrl}
          class="rounded-xl border border-emerald-500/20 bg-[#0b1410] px-4 py-2 text-sm font-medium text-slate-200 hover:border-emerald-400/45 hover:text-white transition-colors"
        >
          Giriş Yap
        </a>
        <a
          href={SITE.registerUrl}
          class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-[#04110b] shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 transition-colors"
        >
          <span>14 Gün Ücretsiz Dene</span>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu (Zero-JS semantik details çekmecesi — sıkı CSP uyumlu) -->
      <details id="mobile-nav-details" class="group md:hidden">
        <summary
          class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-emerald-500/20 bg-[#0b1410] text-slate-200 hover:border-emerald-400/50 hover:text-white select-none"
          aria-label="Menüyü aç veya kapat"
        >
          <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </summary>

        <div class="fixed inset-x-0 top-16 sm:top-[70px] z-50 border-b border-emerald-500/15 bg-[#07100c]/98 backdrop-blur-md shadow-2xl shadow-black/70">
          <div class="mx-auto max-w-7xl px-4 py-4 space-y-2">
            {
              SITE.navigation.map((item) => (
                <a
                  href={item.href}
                  data-mobile-link
                  class="block rounded-xl px-3 py-2.5 text-sm font-medium text-slate-200 hover:bg-[#0b1410] hover:text-emerald-300"
                >
                  {item.label}
                </a>
              ))
            }
            <div class="pt-3 mt-3 border-t border-emerald-500/12 flex flex-col gap-2.5">
              <a
                href={SITE.loginUrl}
                class="w-full text-center rounded-xl border border-emerald-500/25 bg-[#0b1410] px-4 py-2.5 text-sm font-medium text-slate-100"
              >
                Giriş Yap
              </a>
              <a
                href={SITE.registerUrl}
                class="w-full text-center rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-[#04110b]"
              >
                14 Gün Ücretsiz Dene
              </a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
