---
import { SITE } from '../config/site';
---

<header class="sticky top-0 z-50 border-b border-white/[0.08] bg-[#090a0b]/85 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/[0.10] bg-[#111315] group-hover:border-white/[0.20] transition-colors">
          <svg class="h-4 w-4" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M16 48V24.5L32 15L48 24.5V48" stroke="#10b981" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M12 48H52" stroke="#10b981" stroke-width="4" stroke-linecap="round" />
            <rect x="25" y="26" width="5" height="5" rx="1" fill="#34d399" />
            <rect x="34" y="26" width="5" height="5" rx="1" fill="#34d399" />
            <rect x="25" y="34" width="5" height="5" rx="1" fill="#10b981" />
            <rect x="34" y="34" width="5" height="5" rx="1" fill="#10b981" />
          </svg>
        </span>
        <span class="font-display text-base font-bold tracking-tight text-white">
          {SITE.brandName}
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Ana menü" class="hidden md:flex items-center gap-8">
        {
          SITE.navigation.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-zinc-400 hover:text-white transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center gap-2.5">
        <a
          href={SITE.loginUrl}
          class="rounded-lg border border-white/[0.10] bg-[#111315] px-3.5 py-2 text-sm font-medium text-zinc-200 hover:border-white/[0.20] hover:text-white transition-colors"
        >
          Giriş Yap
        </a>
        <a
          href={SITE.registerUrl}
          class="inline-flex items-center rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-[#05110a] hover:bg-emerald-400 transition-colors"
        >
          14 Gün Ücretsiz Dene
        </a>
      </div>

      <!-- Mobile Menu (Zero-JS semantik details çekmecesi — sıkı CSP uyumlu) -->
      <details id="mobile-nav-details" class="group md:hidden">
        <summary
          class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-white/[0.10] bg-[#111315] text-zinc-300 hover:border-white/[0.20] hover:text-white select-none"
          aria-label="Menüyü aç veya kapat"
        >
          <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </summary>

        <div class="fixed inset-x-0 top-16 z-50 border-b border-white/[0.08] bg-[#090a0b]/98 backdrop-blur-md shadow-2xl shadow-black/70">
          <div class="mx-auto max-w-7xl px-4 py-4 space-y-1.5">
            {
              SITE.navigation.map((item) => (
                <a
                  href={item.href}
                  data-mobile-link
                  class="block rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-300 hover:bg-[#15171a] hover:text-white"
                >
                  {item.label}
                </a>
              ))
            }
            <div class="pt-3 mt-3 border-t border-white/[0.08] flex flex-col gap-2">
              <a
                href={SITE.loginUrl}
                class="w-full text-center rounded-lg border border-white/[0.12] bg-[#111315] px-4 py-2.5 text-sm font-medium text-zinc-200"
              >
                Giriş Yap
              </a>
              <a
                href={SITE.registerUrl}
                class="w-full text-center rounded-lg bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-[#05110a]"
              >
                14 Gün Ücretsiz Dene
              </a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
