---
import { SITE } from '../config/site';

const steps = [
  {
    number: '01',
    title: 'Hesap Aç',
    description:
      'Kredi kartı bilgisi girmeden hesabınızı oluşturun ve 14 günlük ücretsiz deneme sürecini başlatın.',
  },
  {
    number: '02',
    title: 'Bina & Daireleri Ekle',
    description:
      'Apartman veya site bilgilerini girin, bağımsız bölümleri ve sakin iletişim kayıtlarını tanımlayın.',
  },
  {
    number: '03',
    title: 'Aidatları Otomatik Takip Et',
    description:
      'Dönemsel tahakkukları oluşturun; ödemeler FIFO ile mahsup edilsin, makbuz ve bildirimler otomatik hazırlansın.',
  },
] as const;
---

<section id="nasil-calisir" class="border-y border-white/[0.08] bg-[#0c0d0f] scroll-mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 sm:py-28">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="text-xs font-medium uppercase tracking-wider text-zinc-500">
          Başlangıç
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white">
          3 adımda kullanıma hazır.
        </h2>
      </div>
      <a
        href={SITE.registerUrl}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-300 hover:text-white transition-colors"
      >
        <span>Ücretsiz hesap oluştur</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-5">
      {
        steps.map((step) => (
          <div class="surface-card specular-top rounded-xl p-6 sm:p-8">
            <span class="mono-num inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/[0.08] bg-[#15171a] text-xs font-semibold text-zinc-300">
              {step.number}
            </span>
            <h3 class="mt-6 text-base font-semibold text-white">{step.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-zinc-400">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
