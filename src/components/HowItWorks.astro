---
import { SITE } from '../config/site';

const steps = [
  {
    number: '01',
    title: 'Hesap Aç',
    description:
      'Kredi kartı bilgisi girmeden 1 dakikada hesabınızı oluşturun ve 14 günlük ücretsiz deneme sürecinizi hemen başlatın.',
  },
  {
    number: '02',
    title: 'Bina & Daireleri Ekle',
    description:
      'Apartman veya site bilgilerinizi girin, daireleri ve sakin iletişim bilgilerini hızlıca tanımlayın.',
  },
  {
    number: '03',
    title: 'Aidatları Otomatik Takip Et',
    description:
      'Dönemsel tahakkukları oluşturun; ödemeler FIFO ile kapansın, A5 PDF makbuzlar ve e-posta bildirimleri otomatik hazırlansın.',
  },
] as const;
---

<section id="nasil-calisir" class="py-20 sm:py-24 border-y border-emerald-500/12 bg-[#09120e] scroll-mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-300">
          Hızlı Başlangıç
        </span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-white">
          3 adımda düzenli apartman yönetimine geçin.
        </h2>
      </div>
      <a
        href={SITE.registerUrl}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors"
      >
        <span>Hemen ücretsiz hesabını oluştur</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 relative">
      {
        steps.map((step, index) => (
          <div class="surface-card rounded-2xl p-6 sm:p-8 relative">
            <div class="flex items-center justify-between">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/15 border border-emerald-500/30 font-display text-sm font-bold text-emerald-300 tabular-nums">
                {step.number}
              </span>
              {index < steps.length - 1 && (
                <span class="hidden md:inline-block text-emerald-500/40 text-lg" aria-hidden="true">
                  &rarr;
                </span>
              )}
            </div>
            <h3 class="mt-6 text-lg font-bold text-white">{step.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-slate-400">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
