---
import { SITE } from '../config/site';
---

<section class="py-24 sm:py-28">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="specular-top rounded-2xl border border-white/[0.10] bg-[#111315] px-6 py-14 sm:px-12 sm:py-16 text-center">
      <div class="mx-auto max-w-xl">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white">
          Apartman ve site yönetiminizi düzenli hale getirin.
        </h2>
        <p class="mt-4 text-base text-zinc-400 leading-relaxed">
          Aidat tahsilatı, A5 PDF makbuz, KVKK pano icmali ve belge arşivini 14 gün boyunca ücretsiz deneyin.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
          <a
            href={SITE.registerUrl}
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500 px-6 py-3 text-sm font-semibold text-[#05110a] hover:bg-emerald-400 transition-colors"
          >
            <span>14 Gün Ücretsiz Dene</span>
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <a
            href={SITE.loginUrl}
            class="inline-flex items-center justify-center rounded-lg border border-white/[0.12] bg-[#181b1f] px-6 py-3 text-sm font-medium text-zinc-200 hover:border-white/[0.22] hover:text-white transition-colors"
          >
            Giriş Yap
          </a>
        </div>

        <p class="mt-4 text-xs text-zinc-500">
          Kredi kartı gerekmez · 1 dakikada kurulum
        </p>
      </div>
    </div>
  </div>
</section>
