---
import { SITE } from '../config/site';
---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl border border-emerald-500/30 bg-gradient-to-br from-[#0f241b] via-[#0b1712] to-[#07100c] px-6 py-14 sm:px-12 sm:py-16 text-center shadow-2xl shadow-emerald-950/50">
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-56 w-96 -translate-x-1/2 rounded-full bg-emerald-500/15 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400">
          Kredi kartı gerekmez · 14 gün ücretsiz
        </p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Apartman yönetimine saatler değil, dakikalar ayırın.
        </h2>
        <p class="mt-4 text-base text-slate-300 leading-relaxed">
          AgyProp ile aidat tahsilatı, A5 PDF makbuzlar, KVKK uyumlu pano icmali ve belge arşivi her zaman elinizin altında olsun.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5">
          <a
            href={SITE.registerUrl}
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-7 py-3.5 text-sm sm:text-base font-semibold text-[#04110b] shadow-xl shadow-emerald-500/25 hover:bg-emerald-400 transition-colors"
          >
            <span>14 Gün Ücretsiz Dene</span>
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <a
            href={SITE.loginUrl}
            class="inline-flex items-center justify-center rounded-xl border border-emerald-500/25 bg-[#07100c]/80 px-6 py-3.5 text-sm sm:text-base font-medium text-slate-100 hover:border-emerald-400/50 hover:bg-[#0b1410] transition-colors"
          >
            Mevcut Hesaba Giriş Yap
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
