---
/**
 * "Excel + WhatsApp vs. AgyProp" sade 2 kolonlu karşılaştırma bloğu.
 */
const legacyItems = [
  {
    title: 'Manuel borç dağıtımı',
    description:
      'Toplu veya kısmi ödemede hangi ayın kapandığı tek tek Excel hücrelerinde hesaplanır; kayma ve hata riski oluşur.',
  },
  {
    title: 'KVKK riskli pano listeleri',
    description:
      'Apartman panosuna açık ad-soyad ile borç listesi asmak hem komşuluk gerilimi hem 6698 sayılı KVKK riski oluşturur.',
  },
  {
    title: 'El yazısı ve Word makbuzlar',
    description:
      'Her tahsilatta ayrı makbuz doldurmak, koçan saklamak ve kopyasını aramak düzenli zaman kaybına yol açar.',
  },
  {
    title: 'WhatsApp’ta kaybolan dekontlar',
    description:
      'Sohbet gruplarına gönderilen dekont görselleri karışır; ay sonunda kasa mutabakatı zorlaşır.',
  },
  {
    title: 'Kayıt ve denetim eksikliği',
    description:
      'Hangi kaydın ne zaman değiştirildiği izlenemez; genel kurul öncesi rapor hazırlamak uzun sürer.',
  },
] as const;

const agypropItems = [
  {
    title: 'Otomatik FIFO borç mahsubu',
    description:
      'Gelen ödeme en eski açık dönemden başlayarak kuruşu kuruşuna kapatılır; kalan bakiye anında güncellenir.',
  },
  {
    title: 'KVKK maskeli pano icmali',
    description:
      'Sakin adları otomatik maskelenmiş (A*** Y*****), ilan panosuna asmaya hazır PDF icmal tek tıkla alınır.',
  },
  {
    title: 'Numaralı A5 PDF makbuz',
    description:
      'Tahsilat işlendiğinde yazıcıya hazır A5 PDF makbuz oluşturulur ve sakinlere e-posta ile iletilir.',
  },
  {
    title: 'Merkezi dekont onayı ve R2 arşivi',
    description:
      'Sakinler dekontlarını sisteme yükler; onaylanan kayıtlar ve faturalar Cloudflare R2 arşivinde saklanır.',
  },
  {
    title: 'Zaman damgalı denetim günlüğü',
    description:
      'Tüm tahsilat ve düzenleme işlemleri kalıcı denetim kaydına işlenir; dönemsel raporlar her an hazırdır.',
  },
] as const;
---

<section aria-labelledby="karsilastirma-baslik" class="py-24 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-wider text-zinc-500">
        Karşılaştırma
      </p>
      <h2 id="karsilastirma-baslik" class="mt-3 text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white">
        Excel ve WhatsApp yerine düzenli kayıt sistemi.
      </h2>
      <p class="mt-4 text-base text-zinc-400 leading-relaxed">
        Her ay tekrarlanan hesap kontrolü, kayıp dekont ve pano hazırlığı iş yükünü azaltın.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
      <!-- Sol Kolon: Eski Yöntem -->
      <div class="rounded-xl border border-white/[0.07] bg-[#0d0f11] p-6 sm:p-8 flex flex-col">
        <div class="border-b border-white/[0.07] pb-5">
          <p class="text-xs font-medium text-zinc-500">Mevcut Yöntem</p>
          <h3 class="mt-1 text-lg font-semibold text-zinc-200">Excel, WhatsApp ve el makbuzu</h3>
        </div>

        <ul class="mt-6 space-y-5 flex-1">
          {
            legacyItems.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 text-zinc-500 mono-num text-xs shrink-0" aria-hidden="true">&mdash;</span>
                <div>
                  <h4 class="text-sm font-medium text-zinc-200">{item.title}</h4>
                  <p class="mt-1 text-xs sm:text-sm leading-relaxed text-zinc-500">{item.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Sağ Kolon: AgyProp -->
      <div class="specular-top rounded-xl border border-white/[0.14] bg-[#111315] p-6 sm:p-8 flex flex-col">
        <div class="border-b border-white/[0.08] pb-5">
          <p class="text-xs font-medium text-zinc-400">AgyProp</p>
          <h3 class="mt-1 text-lg font-semibold text-white">Tek panelde otomatik apartman yönetimi</h3>
        </div>

        <ul class="mt-6 space-y-5 flex-1">
          {
            agypropItems.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                <div>
                  <h4 class="text-sm font-medium text-white">{item.title}</h4>
                  <p class="mt-1 text-xs sm:text-sm leading-relaxed text-zinc-400">{item.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
