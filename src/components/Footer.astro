---
import { SITE } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] bg-[#090a0b]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      <!-- Brand Summary -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/[0.10] bg-[#111315]">
            <svg class="h-4 w-4" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M16 48V24.5L32 15L48 24.5V48" stroke="#10b981" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M12 48H52" stroke="#10b981" stroke-width="4" stroke-linecap="round" />
              <rect x="25" y="26" width="5" height="5" rx="1" fill="#34d399" />
              <rect x="34" y="26" width="5" height="5" rx="1" fill="#34d399" />
              <rect x="25" y="34" width="5" height="5" rx="1" fill="#10b981" />
              <rect x="34" y="34" width="5" height="5" rx="1" fill="#10b981" />
            </svg>
          </span>
          <span class="font-display text-base font-bold tracking-tight text-white">
            {SITE.brandName}
          </span>
        </a>
        <p class="text-sm text-zinc-400 leading-relaxed max-w-sm">
          Apartman ve site yöneticileri için aidat takibi, otomatik FIFO mahsup, A5 PDF makbuz ve KVKK uyumlu yönetim yazılımı.
        </p>
        <p class="mono-num text-xs text-zinc-500">
          yonetim.melihcanaz.tr
        </p>
      </div>

      <!-- Ürün -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-300">Ürün</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-zinc-400">
          {
            SITE.navigation.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={SITE.loginUrl} class="hover:text-white transition-colors">
              Panele Giriş Yap
            </a>
          </li>
          <li>
            <a href={SITE.registerUrl} class="hover:text-white transition-colors">
              14 Gün Ücretsiz Dene
            </a>
          </li>
        </ul>
      </div>

      <!-- Yasal -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-300">Yasal</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-zinc-400">
          {
            SITE.legalLinks.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- İletişim -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-300">İletişim</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-zinc-400">
          <li>
            <a
              href={`mailto:${SITE.company.email}`}
              class="text-zinc-200 hover:text-white transition-colors"
            >
              {SITE.company.email}
            </a>
          </li>
          <li class="text-xs text-zinc-500 leading-relaxed">
            {SITE.company.legalName}
          </li>
          <li class="text-xs text-zinc-500 leading-relaxed">
            {SITE.company.address}
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
      <p>&copy; {currentYear} {SITE.brandName}. Tüm hakları saklıdır.</p>
      <p>melihcanaz.tr</p>
    </div>
  </div>
</footer>
